generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CustomerType {
  PERSON
  ORGANIZATION
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DONE
}

enum MeetingMode {
  PHONE
  ONLINE
  INPERSON
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([email])
}

model ContactMessage {

  id               String        @id @default(cuid())
  customerType     CustomerType
  name             String
  organizationName String?
  email            String
  phone            String?
  service          String
  message          String
  locale           String
  status           MessageStatus @default(NEW)
  ipHash           String?
  createdAt        DateTime      @default(now())

  @@index([status, createdAt])
}

model Consultation {
  id               String        @id @default(cuid())
  trackingCode     String        @unique
  customerType     CustomerType
  name             String
  organizationName String?
  email            String?
  phone            String
  topic            String
  mode             MeetingMode
  startsAt         DateTime
  durationMin      Int           @default(30)
  notes            String?
  locale           String
  status           BookingStatus @default(PENDING)
  ipHash           String?
  createdAt        DateTime      @default(now())

  @@index([startsAt, status])
}

model AvailabilityRule {
  id        Int     @id @default(autoincrement())
  weekday   Int
  startTime String
  endTime   String
  active    Boolean @default(true)
}

model BlockedDate {
  id     Int      @id @default(autoincrement())
  date   DateTime @unique
  reason String?
}

enum ChatSender {
  VISITOR
  STAFF
}

enum ChatStatus {
  OPEN
  CLOSED
}

model ChatConversation {
  id            String        @id @default(cuid())
  tokenHash     String        @unique          // sha256 of the visitor's cookie token (guests + logged-in users)
  userId        String?                        // your User.id when the visitor is logged in (no FK on purpose, so it works with any auth setup)
  name          String?
  email         String?
  status        ChatStatus    @default(OPEN)
  locale        String        @default("fa")
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]

  @@index([userId])
  @@index([status, lastMessageAt])
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         ChatSender
  body           String
  readAt         DateTime?                      // set when staff has read a VISITOR message
  createdAt      DateTime         @default(now())

  @@index([conversationId, id])
}